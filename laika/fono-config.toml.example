# L.A.I.K.A. profile for Fono.
# The local Ollama server remains the language model; no cloud API is used.

[assistant]
enabled = true
backend = "network"

[assistant.network]
url = "http://127.0.0.1:11434/v1/chat/completions"
model = "qwen2.5:1.5b"

# CPU-friendly local speech recognition.
[stt]
backend = "local"

[stt.local]
model = "tiny"
threads = 4

# Local speech output; voice assets are downloaded on first use.
[tts]
backend = "local"

[tts.local]
engine = "supertonic"

# Optional hands-free activation; detection runs locally on the laptop.
[wakeword]
enabled = false

[[wakeword.phrases]]
model = "hey_fono"
sensitivity = 0.5
target = "assistant"

[assistant.tools]
enabled = true

[[assistant.tools.mcp]]
name = "LAIKA Local Tools"
url = "http://127.0.0.1:8765/mcp"
